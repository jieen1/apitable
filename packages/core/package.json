{
  "name": "@apitable/core",
  "version": "1.13.0",
  "description": "datasheet core",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf ./dist && tsc && tsc-alias",
    "build-cjs": "rm -rf ./dist && tsc --module commonjs && tsc-alias",
    "build-rollup": "rm -rf ./dist && rollup -c --bundleConfigAsCjs && tsc-alias",
    "build:publish": "rm -rf ./dist && tsc -p tsconfig.publish.json && tsc-alias -p tsconfig.publish.json && mv ./dist/index-publish.d.ts ./dist/index.d.ts",
    "start": "concurrently \"tsc -w\" \"tsc-alias -w\"",
    "test": "TZ=Asia/Shanghai jest",
    "test:databus": "TZ=Asia/Shanghai jest databus",
    "test:watch": "TZ=Asia/Shanghai jest --watch",
    "test:cov": "TZ=Asia/Shanghai jest --coverage",
    "lint": "eslint src",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "author": "APITable Ltd. <support@apitable.com>",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=8.x"
  },
  "dependencies": {
    "@apitable/databus-wasm-nodejs": "workspace:*",
    "@apitable/databus-wasm-web": "workspace:*",
    "@apitable/i18n": "^1.0.4",
    "@apitable/i18n-lang": "workspace:*",
    "@types/lodash": "^4.17.20",
    "@types/socket.io-client": "^3.0.0",
    "apphook": "1.0.7",
    "attr-accept": "^2.2.5",
    "axios": "1.12.2",
    "color": "^5.0.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dayjs": "^1.11.18",
    "fflate": "^0.8.2",
    "fuse.js": "^7.1.0",
    "immer": "10.1.3",
    "joi": "^18.0.1",
    "json-schema": "^0.4.0",
    "lodash": "^4.17.21",
    "lru-cache": "^11.2.2",
    "moment-timezone": "^0.6.0",
    "ot-json0": "^1.1.0",
    "phone": "^3.1.67",
    "qs": "^6.14.0",
    "re-reselect": "^5.1.0",
    "redux": "5.0.1",
    "redux-batched-actions": "0.5.0",
    "redux-thunk": "3.1.0",
    "reselect": "5.1.1",
    "semver": "^7.7.3",
    "socket.io-client": "4.8.1",
    "string.prototype.matchall": "^4.0.12",
    "urlcat": "^3.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/color": "^4.2.0",
    "@types/jest": "^30.0.0",
    "@types/json-schema": "^7.0.15",
    "@types/lru-cache": "^7.10.10",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^24.9.1",
    "@types/qs": "^6.14.0",
    "@types/string.prototype.matchall": "^4.0.4",
    "eslint": "^9.38.0",
    "fast-check": "^4.3.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "mockjs": "1.1.0",
    "ot-fuzzer": "^1.3.1",
    "rollup": "^4.52.5",
    "ts-jest": "29.4.5",
    "ts-node": "^10.9.2",
    "ts-toolbelt": "^9.6.0",
    "tsc-alias": "^1.8.16",
    "tslib": "^2.8.1",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".(spec|test).ts$",
    "transform": {
      "^.+\\.(t|j)s$": "@swc/jest"
    },
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "moduleNameMapper": {
      "@apitable/databus-wasm-web": "<rootDir>/_skip_transpile_databus_wasm_web.ts"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
