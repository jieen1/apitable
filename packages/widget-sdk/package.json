{
  "name": "@apitable/widget-sdk",
  "version": "1.13.0",
  "description": "apitable widget sdk",
  "sideEffects": false,
  "engines": {
    "node": ">=8.x"
  },
  "keywords": [
    "apitable",
    "widget",
    "sdk",
    "apitable widget sdk"
  ],
  "main": "./dist/index",
  "module": "./dist/index",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "author": "APITable Ltd. <support@apitable.com>",
  "license": "AGPL-3.0",
  "scripts": {
    "copy:static": "copyfiles -f src/static/*.png dist/static",
    "start": "rm -rf ./dist && pnpm run copy:static && concurrently \"tsc -w\" \"tsc-alias -w\"",
    "test": "jest --silent",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "build": "rm -rf ./dist && pnpm copy:static && tsc && tsc-alias",
    "lint": "eslint src/ examples/ --ext .tsx,.ts,.jsx,.js",
    "now-build": "npm run build",
    "docs": "node docs.js"
  },
  "peerDependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "dependencies": {
    "@apitable/components": "workspace:*",
    "@apitable/core": "workspace:*",
    "@apitable/icons": "workspace:*",
    "@testing-library/react-hooks": "^8.0.1",
    "ahooks": "^3.9.5",
    "antd": "5.27.6",
    "attr-accept": "^2.2.5",
    "axios": "1.12.2",
    "bowser": "^2.12.1",
    "dayjs": "^1.11.18",
    "emoji-mart": "^5.6.0",
    "fundebug-javascript": "^2.8.8",
    "immer": "10.1.3",
    "loadjs": "^4.3.0",
    "localforage": "^1.10.0",
    "lodash": "^4.17.21",
    "lodash.without": "^4.4.0",
    "mime-types": "^3.0.1",
    "rc-picker": "^4.11.3",
    "re-reselect": "^5.1.0",
    "react-redux": "9.2.0",
    "react-virtualized-auto-sizer": "1.0.26",
    "redux": "5.0.1",
    "redux-batched-actions": "0.5.0",
    "redux-thunk": "3.1.0",
    "reselect": "5.1.1",
    "resize-observer-polyfill": "^1.5.1",
    "socket.io-client": "4.8.1",
    "store2": "^2.14.4"
  },
  "devDependencies": {
    "@types/copyfiles": "^2",
    "@types/emoji-mart": "^5.3.0",
    "@types/jest": "^30.0.0",
    "@types/loadjs": "^4",
    "@types/localforage": "^0.0.34",
    "@types/lodash": "^4.17.20",
    "@types/mime-types": "^3.0.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-redux": "^7.1.34",
    "@types/resize-observer-browser": "^0.1.11",
    "@types/socket.io-client": "^3.0.0",
    "@types/styled-components": "5.1.35",
    "babel-jest": "^30.2.0",
    "concurrently": "^9.2.1",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "styled-components": "6.1.19",
    "ts-jest": "29.4.5",
    "tsc-alias": "^1.8.16",
    "typedoc": "0.28.14",
    "typedoc-plugin-markdown": "4.9.0",
    "typescript": "5.9.3",
    "typescript-plugin-styled-components": "^3.0.0"
  }
}
