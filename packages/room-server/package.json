    "debug": "^4.4.3",
    "dompurify": "^3.3.0",
    "express": "5.1.0",
    "fast-safe-stringify": "^2.1.1",
    "fastify": "5.6.1",
    "fastify-helmet": "7.1.0",
    "fastify-multipart": "5.4.0",
    "fastify-swagger": "5.2.0",
    "fecha": "4.2.3",
    "form-data": "^4.0.4",
    "getmac": "^6.6.0",
    "helmet": "8.1.0",
    "immer": "10.1.3",
    "ioredis": "^5.8.2",
    "js-yaml": "^4.1.0",
    "jsdom": "^27.0.1",
    "lodash": "^4.17.21",
    "logform": "^2.7.0",
    "marked": "^16.4.1",
    "minio": "^8.0.6",
    "mysql2": "^3.15.3",
    "nest-winston": "^1.10.2",
    "nestjs-i18n": "^10.5.1",
    "nestjs-proto-gen-ts": "^1.0.21",
    "node-os-utils": "^2.0.1",
    "nodemailer": "^7.0.10",
    "piscina": "^5.1.3",
    "protobufjs": "^7.5.4",
    "pump": "^3.0.3",
    "qs": "^6.14.0",
    "rate-limiter-flexible": "^8.1.0",
    "redux": "5.0.1",
    "redux-batched-actions": "0.5.0",
    "redux-thunk": "3.1.0",
    "rimraf": "^6.0.1",
    "rxjs": "7.8.2",
    "sha1": "^1.1.1",
    "socket.io": "^4.8.1",
    "sprintf-js": "^1.1.3",
    "triple-beam": "^1.4.1",
    "ts-md5": "^2.0.1",
    "typeorm": "^0.3.27",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "y-prosemirror": "^1.3.7",
