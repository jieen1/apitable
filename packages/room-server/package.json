{
  "name": "@apitable/room-server",
  "version": "1.13.0",
  "description": "nodejs room server",
  "author": "APITable Ltd. <support@apitable.com>",
  "license": "AGPL-3.0",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "NODE_DEBUG=bull ENABLE_SOCKET=true nest start",
    "start:dev": "pnpm start --watch",
    "start:debug": "pnpm start --debug --watch",
    "start:room-server:perf:flame": "clinic flame -- node dist/main",
    "start:room-server:perf:doctor": "clinic doctor -- node dist/main",
    "start:room-server:perf:heapprofiler": "clinic heapprofiler -- node dist/main",
    "start:room-server:perf:bubbleprof": "clinic bubbleprof -- node dist/main",
    "start:prod": "node dist/main",
    "start:room": "APPLICATION_NAME=ROOM_SERVER SERVER_PORT=3333 ENABLE_SOCKET=false nest start",
    "start:room:dev": "pnpm start:room --watch",
    "start:socket": " APPLICATION_NAME=SOCKET_SERVER SERVER_PORT=3001 ENABLE_SOCKET=true nest start",
    "start:socket:dev": "pnpm start:socket --watch",
    "lint": "eslint src",
    "test": "jest --logHeapUsage --verbose --silent --ci --updateSnapshot --runInBand --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --colors --logHeapUsage --verbose --silent",
    "test:ut": "DOTENV_CONFIG_PATH=src/env/.env.dev-test jest --config ./jest-ut.config.json --colors --logHeapUsage --verbose --silent --ci --detectOpenHandles --forceExit",
    "test:ut:cov": "jest --config ./jest-ut.config.json --logHeapUsage --verbose --silent --ci --updateSnapshot --runInBand --detectOpenHandles --forceExit --testTimeout=60000 --coverage --coverageDirectory=coverage",
    "grpc:build": "tsproto --path src/proto --output src/proto/generated",
    "grpc:clean": "rimraf src/proto/generated",
    "copy:assets": "cp -r 'src/grpc/' 'dist/grpc/' && cp 'src/shared/helpers/list.lock.lua' 'dist/shared/helpers/list.lock.lua'"
  },
  "engines": {
    "node": "22.21.0"
  },
  "dependencies": {
    "@apitable/core": "workspace:*",
    "@apitable/i18n-lang": "workspace:*",
    "@apitable/nestjs-redis": "1.3.4",
    "@aws-sdk/client-s3": "3.916.0",
    "@elastic/ecs-helpers": "2.1.1",
    "@elastic/ecs-winston-format": "1.5.3",
    "@golevelup/nestjs-rabbitmq": "6.0.2",
    "@grpc/grpc-js": "~1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "@hapi/joi": "^17.1.1",
    "@hocuspocus/extension-database": "^3.4.0",
    "@hocuspocus/extension-redis": "^3.4.0",
    "@hocuspocus/server": "^3.4.0",
    "@hocuspocus/transformer": "^3.4.0",
    "@metinseylan/nestjs-opentelemetry": "3.0.0",
    "@nestjs/axios": "4.0.1",
    "@nestjs/bull": "11.0.4",
    "@nestjs/common": "11.1.7",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.7",
    "@nestjs/event-emitter": "3.0.1",
    "@nestjs/microservices": "~11.1.7",
    "@nestjs/platform-fastify": "11.1.7",
    "@nestjs/platform-socket.io": "11.1.7",
    "@nestjs/schedule": "6.0.1",
    "@nestjs/swagger": "11.2.1",
    "@nestjs/terminus": "11.0.0",
    "@nestjs/typeorm": "11.0.0",
    "@nestjs/websockets": "11.1.7",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.66.0",
    "@opentelemetry/core": "2.2.0",
    "@opentelemetry/exporter-jaeger": "^2.2.0",
    "@opentelemetry/instrumentation-grpc": "^0.207.0",
    "@opentelemetry/instrumentation-http": "^0.207.0",
    "@opentelemetry/instrumentation-mysql": "^0.53.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@opentelemetry/semantic-conventions": "1.37.0",
    "@sentry/core": "10.22.0",
    "@sentry/node": "^10.22.0",
    "@sentry/serverless": "^7.120.4",
    "@sentry/tracing": "^7.120.4",
    "@sentry/types": "^10.22.0",
    "@sentry/utils": "8.55.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.12.2",
    "bull": "^4.16.5",
    "cache-manager": "^7.2.4",
