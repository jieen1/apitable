    "cron-parser": "^5.4.0",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.7",
    "@types/cache-manager": "^4.0.6",
    "@types/cli-color": "^2.0.6",
    "@types/cls-hooked": "^4.3.9",
    "@types/dompurify": "^3",
    "@types/express": "^5",
    "@types/hapi__joi": "^17.1.15",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^27",
    "@types/lodash": "^4.17.20",
    "@types/marked": "^6",
    "@types/minio": "^7.1.1",
    "@types/node": "^24.9.1",
    "@types/node-fetch": "^2.6.13",
    "@types/node-os-utils": "^1.3.4",
    "@types/nodemailer": "^7",
    "@types/pump": "^1.1.3",
    "@types/qs": "^6.14.0",
    "@types/sha1": "^1",
    "@types/socket.io": "^3.0.2",
    "@types/sprintf-js": "^1.1.4",
    "@types/supertest": "^6.0.3",
    "@types/triple-beam": "^1.3.5",
    "@types/luxon": "^3.7.1",
    "chai": "^6.2.0",
    "clinic": "^13.0.0",
    "eslint": "^9.38.0",
    "jest": "30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "node-fetch": "3",
    "supertest": "^7.1.4",
    "ts-jest": "29.4.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "^.+\\.js$"
    ],
    "moduleNameMapper": {
      "@apitable/databus-wasm-web": "<rootDir>/_skip_transpile_databus_wasm_web.ts"
    },
    "moduleDirectories": [
      "dist",
      "node_modules",
      "src"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
